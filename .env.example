NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb://127.0.0.1:27017/iiitbhopal_tnp
REDIS_URL=redis://127.0.0.1:6379

SESSION_SECRET=
SESSION_NAME=tnp.sid
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=86400000

CSRF_SECRET=

COLLEGE_EMAIL_DOMAIN=iiitbhopal.ac.in

SEED_ADMIN_EMAIL=admin@iiitbhopal.ac.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=9999999999

OTP_LENGTH=6
OTP_TTL_SECONDS=300

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESUME_ACCESS_MODE=authenticated

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=25000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Signup and login OTPs are sent with these SMTP settings.

FLASH_AUTO_DISMISS_MS=6000
LOG_LEVEL=info
