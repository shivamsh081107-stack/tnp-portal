<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="p-4">
    <h1>IIIT Bhopal TNP</h1>
    <% if (success_msg && success_msg.length) { %>
    <div class="alert alert-success"><%= success_msg.join(' ') %></div>
    <% } %> <% if (error_msg && error_msg.length) { %>
    <div class="alert alert-danger"><%= error_msg.join(' ') %></div>
    <% } %>
    <p>This page uses connect-flash and res.locals for Express-rendered notices. The React app uses JSON flash payloads instead.</p>
  </body>
</html>
